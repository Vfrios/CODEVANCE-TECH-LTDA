{
  "name": "codevance-tech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n front,back -c cyan,green \"pnpm run dev:front\" \"pnpm run dev:back\"",
    "dev:front": "vite",
    "dev:back": "node --watch server/index.js",
    "start": "node server/index.js",
    "start:back": "node server/index.js",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
